---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const contactEmail = 'hello@theartdeco.com';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Contact The Art Deco with editorial questions, partnership inquiries, or a note about home design." />
    <title>Contact Us | The Art Deco</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#FAF9F6] font-sans text-stone-800">
    <Header />
    <main class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
      <header class="mx-auto max-w-3xl text-center">
        <p class="text-[10px] font-semibold uppercase tracking-[0.36em] text-[#5c534d]">We would love to hear from you</p>
        <h1 class="mt-5 font-serif text-4xl font-semibold tracking-[0.06em] text-[#121212] sm:text-5xl">Contact Us</h1>
        <p class="mt-6 text-base leading-7 text-stone-600">Questions, thoughtful feedback, or a collaboration in mind? Send us a note.</p>
      </header>

      <div class="mx-auto mt-12 grid max-w-5xl gap-12 border-y border-[#e8e0d2] py-10 md:grid-cols-[0.75fr_1.25fr] md:gap-16 md:py-14">
        <section>
          <p class="text-[10px] font-semibold uppercase tracking-[0.3em] text-[#5c534d]">Email</p>
          <a href={`mailto:${contactEmail}`} class="mt-3 inline-block break-all font-serif text-xl text-[#121212] underline decoration-[#c5a059]/70 underline-offset-4">{contactEmail}</a>
          <p class="mt-5 max-w-sm text-sm leading-6 text-stone-600">For editorial questions, press, and partnership inquiries, please include a little context in your message.</p>
        </section>

        <section>
          <form action={`mailto:${contactEmail}`} method="post" enctype="text/plain" class="space-y-5">
            <div class="grid gap-5 sm:grid-cols-2">
              <label class="block text-xs font-medium text-stone-700">
                Name
                <input name="name" autocomplete="name" required class="mt-2 block min-h-12 w-full rounded-sm border border-[#d9d2c7] bg-white/80 px-4 text-sm text-[#121212] outline-none transition focus:border-[#c5a059] focus:ring-2 focus:ring-[#c5a059]/20" />
              </label>
              <label class="block text-xs font-medium text-stone-700">
                Email
                <input name="email" type="email" autocomplete="email" required class="mt-2 block min-h-12 w-full rounded-sm border border-[#d9d2c7] bg-white/80 px-4 text-sm text-[#121212] outline-none transition focus:border-[#c5a059] focus:ring-2 focus:ring-[#c5a059]/20" />
              </label>
            </div>
            <label class="block text-xs font-medium text-stone-700">
              Subject
              <input name="subject" required class="mt-2 block min-h-12 w-full rounded-sm border border-[#d9d2c7] bg-white/80 px-4 text-sm text-[#121212] outline-none transition focus:border-[#c5a059] focus:ring-2 focus:ring-[#c5a059]/20" />
            </label>
            <label class="block text-xs font-medium text-stone-700">
              Message
              <textarea name="message" rows="6" required class="mt-2 block w-full resize-y rounded-sm border border-[#d9d2c7] bg-white/80 px-4 py-3 text-sm leading-6 text-[#121212] outline-none transition focus:border-[#c5a059] focus:ring-2 focus:ring-[#c5a059]/20"></textarea>
            </label>
            <button type="submit" class="inline-flex min-h-12 items-center justify-center border border-[#c5a059] bg-[#121212] px-6 text-[10px] font-semibold uppercase tracking-[0.22em] text-white transition hover:bg-[#292621]">Send message</button>
            <p class="text-xs leading-5 text-stone-500">Submitting opens your default email app with your message. No message data is stored on this website.</p>
          </form>
        </section>
      </div>
    </main>
    <Footer />
  </body>
</html>
