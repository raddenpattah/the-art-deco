---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ShopTheLook from '../components/ShopTheLook.astro';
import AdSlot from '../components/AdSlot.astro';
import '../styles/global.css';
import edits from '../data/edits.json';
import products from '../data/products.json';

const moreFeaturedEdits = edits;
const mostLovedFinds = products;
const showHeaderAd = false;
const showMidPageAd = false;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="The Art Deco — Curated Home Decor & Shop The Look featuring elevated design inspiration and refined Amazon finds."
    />
    <title>The Art Deco</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#FAF9F6] font-sans text-stone-800">
    <Header />

    {showHeaderAd && (
      <div class="mx-auto max-w-6xl px-4 pb-4 pt-5 sm:px-6 lg:px-8">
        <AdSlot
          showAd={showHeaderAd}
          label="Advertisement"
          height="h-20 sm:h-24 lg:h-28"
          className="mx-auto max-w-5xl"
        />
      </div>
    )}

    <main class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8 lg:py-16">
      <header class="mb-10 text-center sm:mb-14">
        <p class="text-[10px] font-semibold uppercase tracking-[0.38em] text-[#5c534d]">Curated Home Decor & Shop The Look</p>
        <h1 class="mt-5 font-serif text-4xl font-semibold tracking-[0.2em] text-[#121212] sm:text-5xl lg:text-7xl">
          The Art Deco
        </h1>
        <p class="mx-auto mt-5 max-w-3xl text-base leading-7 text-stone-600 sm:text-lg">
          Refined interiors, statement styling, and elevated essentials for a modern home with a timeless edge.
        </p>
      </header>

      <section class="mb-12 grid gap-6 md:grid-cols-3">
        {[
          {
            title: 'Living Room',
            description: 'Layered comfort, soft textures, and sculptural silhouettes.',
            image: 'https://images.unsplash.com/photo-1494526585095-c41746248156?auto=format&fit=crop&w=900&q=80',
          },
          {
            title: 'Bedroom',
            description: 'Warm woods, quiet luxury, and a restful palette.',
            image: 'https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=900&q=80',
          },
          {
            title: 'Dining',
            description: 'Refined hosting with artisanal pieces and natural charm.',
            image: 'https://images.unsplash.com/photo-1524758631624-e2822e304c36?auto=format&fit=crop&w=900&q=80',
          },
        ].map((category) => (
          <article class="group overflow-hidden rounded-[1.75rem] border border-[#e8e0d2] bg-white shadow-soft transition duration-300 hover:-translate-y-1 hover:shadow-xl">
            <div class="overflow-hidden">
              <img src={category.image} alt={category.title} class="h-56 w-full object-cover transition duration-500 group-hover:scale-105" />
            </div>
            <div class="p-5">
              <p class="text-[10px] font-semibold uppercase tracking-[0.28em] text-[#5c534d]">Collection</p>
              <h3 class="mt-3 font-serif text-2xl font-semibold tracking-[0.04em] text-[#121212]">{category.title}</h3>
              <p class="mt-2 text-sm leading-6 text-stone-600">{category.description}</p>
            </div>
          </article>
        ))}
      </section>

      <article class="overflow-hidden rounded-[2rem] border border-[#e8e0d2] bg-white/90 p-4 shadow-soft ring-1 ring-black/5 sm:p-6 lg:p-8">
        <div class="mb-8 grid gap-8 lg:grid-cols-[1.2fr_0.8fr]">
          <div class="overflow-hidden rounded-[1.5rem]">
            <img
              src="https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=1200&q=80"
              alt="Minimal and warm modern interior"
              class="h-[360px] w-full object-cover sm:h-[440px]"
            />
          </div>

          <div class="flex flex-col justify-center">
            <p class="text-[10px] font-semibold uppercase tracking-[0.3em] text-[#5c534d]">Featured story</p>
            <h2 class="mt-3 font-serif text-3xl font-semibold tracking-[0.04em] text-[#121212] sm:text-4xl">How to create a relaxed, elevated living room</h2>
            <p class="mt-4 text-base leading-7 text-stone-600">
              The secret is in the layering: natural textures, soft lighting, and a few intentional statement pieces that make the whole room feel inviting without trying too hard.
            </p>

            <ul class="mt-6 space-y-3 text-sm text-stone-700">
              <li class="flex items-start gap-3">
                <span class="mt-1 inline-block h-2.5 w-2.5 rounded-full bg-[#121212]"></span>
                Choose warm neutral tones with a mix of linen, oak, and stone.
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1 inline-block h-2.5 w-2.5 rounded-full bg-[#c5a059]"></span>
                Add texture through woven accents, sculptural lighting, and layered textiles.
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1 inline-block h-2.5 w-2.5 rounded-full bg-[#121212]"></span>
                Keep the palette anchored and uncluttered so every object feels intentional.
              </li>
            </ul>
          </div>
        </div>

        <ShopTheLook />
      </article>

      <section class="mt-14">
        <div class="mb-8 flex items-end justify-between gap-4">
          <div>
            <p class="text-[10px] font-semibold uppercase tracking-[0.32em] text-[#5c534d]">More edits</p>
            <h2 class="mt-2 font-serif text-3xl font-semibold tracking-[0.04em] text-[#121212] sm:text-4xl">Shop more room stories</h2>
          </div>
          <a href="#" class="hidden text-[10px] font-semibold uppercase tracking-[0.22em] text-[#121212] transition hover:text-[#c5a059] sm:inline-block">View all</a>
        </div>

        <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-4">
          {moreFeaturedEdits.map((edit) => (
            <article class="group flex flex-col overflow-hidden rounded-[1.75rem] border border-[#e8e0d2] bg-white shadow-soft transition duration-300 hover:-translate-y-1 hover:shadow-xl">
              <div class="overflow-hidden">
                <img src={edit.image} alt={edit.title} class="h-72 w-full object-cover transition duration-500 group-hover:scale-105" />
              </div>
              <div class="flex flex-1 flex-col p-5">
                <p class="text-[10px] font-semibold uppercase tracking-[0.28em] text-[#5c534d]">{edit.label}</p>
                <h3 class="mt-3 font-serif text-2xl font-semibold tracking-[0.03em] text-[#121212]">{edit.title}</h3>
                <p class="mt-3 text-sm leading-6 text-stone-600">{edit.description}</p>
                <div class="mt-auto pt-5">
                  <a
                    href={edit.href}
                    target="_blank"
                    rel="sponsored nofollow noopener noreferrer"
                    class="inline-flex items-center justify-center rounded-full border border-[#c5a059]/80 bg-[#121212] px-4 py-2 text-[10px] font-semibold uppercase tracking-[0.18em] text-white transition duration-300 hover:-translate-y-0.5 hover:border-[#d7bb72] hover:bg-[#1f1f1f]"
                  >
                    {edit.cta}
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      {showMidPageAd && (
        <div class="my-10">
          <AdSlot
            showAd={showMidPageAd}
            label="Sponsored"
            height="h-24 sm:h-28 lg:h-32"
            className="mx-auto max-w-5xl"
          />
        </div>
      )}

      <section class="mt-16">
        <div class="mb-8 flex items-end justify-between gap-4">
          <div>
            <p class="text-[10px] font-semibold uppercase tracking-[0.32em] text-[#5c534d]">Most loved</p>
            <h2 class="mt-2 font-serif text-3xl font-semibold tracking-[0.04em] text-[#121212] sm:text-4xl">Most Loved Finds</h2>
          </div>
        </div>

        <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-4">
          {mostLovedFinds.map((product) => (
            <article class="group overflow-hidden rounded-[1.75rem] border border-[#e8e0d2] bg-white shadow-soft transition duration-300 hover:-translate-y-1 hover:shadow-xl">
              <div class="overflow-hidden">
                <img src={product.image} alt={product.name} class="h-64 w-full object-cover transition duration-500 group-hover:scale-105" />
              </div>
              <div class="p-5">
                <p class="text-[10px] font-semibold uppercase tracking-[0.28em] text-[#5c534d]">Home styling</p>
                <h3 class="mt-3 font-serif text-2xl font-semibold tracking-[0.03em] text-[#121212]">{product.name}</h3>
                <div class="mt-4 flex items-center justify-between gap-4">
                  <span class="text-sm font-semibold text-[#121212]">{product.price}</span>
                  <a
                    href={product.href}
                    target="_blank"
                    rel="sponsored nofollow noopener noreferrer"
                    class="inline-flex items-center justify-center rounded-full border border-[#c5a059]/80 bg-[#faf9f6] px-3 py-2 text-[10px] font-semibold uppercase tracking-[0.18em] text-[#121212] transition duration-300 hover:border-[#d7bb72] hover:bg-[#f4efe8]"
                  >
                    View on Amazon
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
