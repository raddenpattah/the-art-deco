---
const navItems = [
  'Living Room',
  'Bedroom',
  'Dining',
  'Shop The Look',
];
---

<header class="sticky top-0 z-50 border-b border-gold-200/70 bg-[#faf9f6]/90 backdrop-blur-xl">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
    <a href="/" class="flex items-center gap-3" aria-label="The Art Deco home">
      <div class="flex h-10 w-10 items-center justify-center rounded-full border border-gold-300/80 bg-[#121212] text-sm font-semibold tracking-[0.25em] text-[#faf9f6]">
        A
      </div>
      <div>
        <p class="text-[10px] font-semibold uppercase tracking-[0.32em] text-stone-500">Curated Home</p>
        <p class="text-lg font-semibold tracking-[0.2em] text-[#121212]">The Art Deco</p>
      </div>
    </a>

    <nav aria-label="Main navigation" class="hidden items-center gap-7 md:flex">
      {navItems.map((item) => (
        <a
          href="#"
          class="text-xs font-medium uppercase tracking-[0.2em] text-stone-600 transition duration-300 hover:text-[#c5a059]"
        >
          {item}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="#"
        class="hidden rounded-full border border-[#c5a059]/70 bg-[#121212] px-4 py-2 text-[10px] font-semibold uppercase tracking-[0.2em] text-[#faf9f6] shadow-lg shadow-[#121212]/10 transition duration-300 hover:-translate-y-0.5 hover:border-[#d7bb72] hover:bg-[#1f1f1f] sm:inline-flex"
      >
        Shop This Edit
      </a>
      <button
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-gold-300/80 bg-[#121212] text-[#faf9f6] md:hidden"
        aria-label="Open menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <path d="M3 7h18M3 12h18M3 17h18" />
        </svg>
      </button>
    </div>
  </div>

  <div class="border-t border-gold-200/80 bg-[#f4efe8] md:hidden">
    <nav aria-label="Mobile navigation" class="mx-auto flex max-w-6xl flex-col px-4 py-3 sm:px-6">
      {navItems.map((item) => (
        <a href="#" class="py-2 text-xs font-medium uppercase tracking-[0.2em] text-stone-700 hover:text-[#121212]">
          {item}
        </a>
      ))}
    </nav>
  </div>
</header>
